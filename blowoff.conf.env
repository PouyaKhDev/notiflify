# ==============================================================================
# BINANCE FUTURES BLOW-OFF TOP / PARABOLIC SHORT SCANNER CONFIGURATION
# File: blowoff.conf.env
# ==============================================================================
# Completely isolated scanner detecting parabolic blow-off tops on Binance USDT-M Perpetuals.
# Any CLI flag passed to run_blowoff_scanner.py overrides these config values.

# ------------------------------------------------------------------------------
# 1. BINANCE FUTURES API & NETWORK CONFIGURATION
# ------------------------------------------------------------------------------
# Base REST API endpoint for Binance USDT-M Futures
BINANCE_BASE_URL=https://fapi.binance.com

# HTTP/HTTPS Proxy (optional, leave empty to use system environment or direct connection)
# Note: Binance restricts access from US and UK IPs. If running through a proxy,
# ensure your exit node is in an allowed jurisdiction (e.g., Germany, Netherlands, Singapore).
# Example: HTTP_PROXY=http://127.0.0.1:2080
HTTP_PROXY=
HTTPS_PROXY=

# Request timeout in seconds
REQUEST_TIMEOUT=10

# ThreadPoolExecutor worker count for concurrent klines fetching
WORKERS=8

# ------------------------------------------------------------------------------
# 2. UNIVERSE & LIQUIDITY FILTERS
# ------------------------------------------------------------------------------
# Minimum 24h price change percentage (+15.0%)
MIN_PUMP_PCT=10.0

# Minimum 24h quote volume (turnover in USDT)
# Recommended: 10,000,000 ($10M) to ensure orderbook liquidity for shorting
MIN_TURNOVER=10000000

# Stablecoin/Fiat pegged base assets to exclude from scanning
EXCLUDE_STABLES=USDC,FDUSD,TUSD,EUR,BUSD,DAI,USDP,AEUR

# ------------------------------------------------------------------------------
# 3. MULTI-TIMEFRAME BLOW-OFF SETUP PARAMETERS
# ------------------------------------------------------------------------------
# Climactic volume spike multiplier against 20-period volume SMA
# Triggers if either 1H volume >= 3.0x SMA20 OR 15M volume >= 3.0x SMA20
VOL_CLIMAX_MULT=3.0

# RSI Overbought/Exhaustion threshold (14-period)
# Triggers if either 1H RSI >= 70.0 OR 15M RSI >= 70.0
RSI_THRESHOLD=70.0

# Informational upper wick rejection threshold (in % of high-low range)
# Note: Used for highlighting in tables/alerts. Not a blocking filter.
WICK_REJECTION_THRESHOLD=40

# ------------------------------------------------------------------------------
# 4. EXECUTION & SCHEDULING
# ------------------------------------------------------------------------------
# Continuous scanner loop interval in seconds (300 seconds = 5 minutes)
SCAN_INTERVAL_SEC=300

# ------------------------------------------------------------------------------
# 5. TELEGRAM ALERTS (OPTIONAL)
# ------------------------------------------------------------------------------
# Set to true to broadcast detected blow-off setups to Telegram
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
